#include <stdio.h>
#include <stdbool.h>

int findLRU(int time[], int n) {
    int i, minimum = time[0], pos = 0;
    for (i = 1; i < n; ++i) {
        if (time[i] < minimum) {
            minimum = time[i];
            pos = i;
        }
    }
    return pos;
}

int main() {
    int n, capacity, i, j, counter = 0, faults = 0, hits = 0;
    
    printf("Enter number of pages in reference string: \n");
    scanf("%d", &n);
    
    int pages[n];
    printf("Enter the reference string: \n");
    for (i = 0; i < n; i++) {
        scanf("%d", &pages[i]);
    }
    
    printf("Enter number of frames: \n");
    scanf("%d", &capacity);

    int frames[capacity], time[capacity];
    for (i = 0; i < capacity; i++) {
        frames[i] = -1;
    }

    for (i = 0; i < n; i++) {
        bool isHit = false;

        for (j = 0; j < capacity; j++) {
            if (frames[j] == pages[i]) {
                counter++;
                hits++;
                time[j] = counter;
                isHit = true;
                break;
            }
        }
        if (!isHit) {
            if (frames[0] == -1 || frames[1] == -1 || frames[capacity-1] == -1) {
                // Find empty frame
                for(j = 0; j < capacity; j++) {
                    if(frames[j] == -1) {
                        counter++;
                        faults++;
                        frames[j] = pages[i];
                        time[j] = counter;
                        break;
                    }
                }
            } else {
                // All frames full, use LRU logic
                int pos = findLRU(time, capacity);
                counter++;
                faults++;
                frames[pos] = pages[i];
                time[pos] = counter;
            }
        }
    }

    printf("\nTotal Page Faults: %d", faults);
    printf("\nTotal Page Hits: %d\n", hits);

    return 0;
}
